__pycache__/
*.pyc

# playwright is installed on demand by the verify workflows, never committed
node_modules/
package-lock.json
reports/proofs/*.evidence.json
artifacts/

# Transient browser-audit output: screenshots and JSON rewritten on every run.
# Ignoring is not untracking - the seven files below were tracked, so they are
# removed from the index in the same commit as this rule. See
# tools/verify_audit_output_guard.sh for the assertion this displaced.
audit-output/

# Local Play build/QA output (a build product, never a source of truth).
# Retained as CI artifacts, never committed - the same rule audit-output/ carries.
.play-review/

# Local source checkouts a replay mounts (the CI job creates them itself).
.sources/
