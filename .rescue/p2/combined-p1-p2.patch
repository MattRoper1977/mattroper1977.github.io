diff --git a/.github/workflows/mbm-audience-discovery-closeout.yml b/.github/workflows/mbm-audience-discovery-closeout.yml
index 572d9c2..3e5d847 100644
--- a/.github/workflows/mbm-audience-discovery-closeout.yml
+++ b/.github/workflows/mbm-audience-discovery-closeout.yml
@@ -22,6 +22,19 @@ jobs:
     steps:
       - uses: actions/checkout@v4
 
+      - uses: actions/setup-node@v4
+        with: { node-version: '22' }
+
+      - name: Install Playwright Chromium
+        # The copy gate is static, but the search-prominence gate is not and
+        # cannot be: whether a control is above the fold at 390px, whether
+        # anything covers it, and whether typing reaches the network are
+        # runtime facts. A source grep for the search script called all seven
+        # of these pages covered while none of them rendered a box.
+        run: |
+          npm i --no-save playwright@1.56.1
+          npx playwright install --with-deps chromium
+
       - name: Generated audience HTML is byte-for-byte reproducible
         run: python3 tools/render_audience_homepages.py --check
 
@@ -40,6 +53,19 @@ jobs:
       - name: Audience architecture, labels and privacy contract hold
         run: python3 tools/verify_games_audience_faces.py
 
+      - name: Search is findable, lazy, and fenced on the pupil page
+        run: node tools/verify_search_prominence.mjs
+
+      - name: Each route serves the copy its own record owns
+        # The reported defect was copy that had only the audience label
+        # changed, so the assertions that matter are cross-contamination ones:
+        # a page serving another page's block, or two pages sharing one. The
+        # gate holds NO copy of the authorised sentences — it reads them from
+        # data/audience-homepages.json and asserts an identity — because a
+        # second literal parked in a test breaks the first time Matt edits a
+        # word rather than when a surface actually drifts.
+        run: node tools/verify_audience_copy.mjs
+
       - name: Design inheritance holds across audience surfaces
         run: python3 tools/verify_design_inheritance.py
 
@@ -52,6 +78,53 @@ jobs:
 
       # A gate that has never failed is not evidence. Each control perturbs the
       # tree and asserts the matching verifier notices, then restores it.
+      - name: Prominence gate notices a missing entry point
+        run: |
+          set -e
+          cp for/trusts/index.html /tmp/sp.bak
+          python3 - <<'PY'
+          import io, re
+          p = 'for/trusts/index.html'
+          s = io.open(p, encoding='utf-8').read()
+          s = re.sub(r'<div class="mf-hero-search">.*?</form></div>', '', s, count=1, flags=re.S)
+          io.open(p, 'w', encoding='utf-8').write(s)
+          PY
+          if node tools/verify_search_prominence.mjs; then
+            echo "::error::prominence gate stayed green with the entry point removed from /for/trusts/"
+            cp /tmp/sp.bak for/trusts/index.html
+            exit 1
+          fi
+          cp /tmp/sp.bak for/trusts/index.html
+          node tools/verify_search_prominence.mjs
+
+      - name: Copy gate notices one page serving another page's block
+        run: |
+          set -e
+          cp for/trusts/index.html /tmp/t.bak
+          cp for/councils-organisations/index.html /tmp/c.bak
+          python3 - <<'PY'
+          import io, json
+          d = json.load(open('data/audience-homepages.json', encoding='utf-8'))
+          esc = lambda s: (s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')
+                            .replace('"','&quot;').replace("'",'&#x27;'))
+          t = esc(d['audiences']['trusts']['sections'][0]['lead'])
+          c = esc(d['audiences']['councils']['sections'][0]['lead'])
+          for f, a, b in (('for/trusts/index.html', t, c),
+                          ('for/councils-organisations/index.html', c, t)):
+              s = io.open(f, encoding='utf-8').read()
+              assert a in s, f
+              io.open(f, 'w', encoding='utf-8').write(s.replace(a, b, 1))
+          PY
+          if node tools/verify_audience_copy.mjs; then
+            echo "::error::copy gate stayed green with the Trusts and Councils intros swapped"
+            cp /tmp/t.bak for/trusts/index.html
+            cp /tmp/c.bak for/councils-organisations/index.html
+            exit 1
+          fi
+          cp /tmp/t.bak for/trusts/index.html
+          cp /tmp/c.bak for/councils-organisations/index.html
+          node tools/verify_audience_copy.mjs
+
       - name: Renderer notices a hand-edited generated page
         run: |
           set -euo pipefail
diff --git a/assets/mbm-audience.css b/assets/mbm-audience.css
index 2418bff..1fe39d0 100644
--- a/assets/mbm-audience.css
+++ b/assets/mbm-audience.css
@@ -597,3 +597,29 @@ body[data-theme="dark"] .mf-band-link{color:#F2A24A}
 .mf-pupil-take{font-size:.86rem;color:#3b4166}
 .mf-pupil-game .mf-text-link{min-height:44px;display:inline-flex;align-items:center}
 .mf-masthead a.mf-brand,.mf-brand{min-height:44px;display:inline-flex;align-items:center}
+
+/* The closing line. Editorial, and deliberately quieter than a card grid and
+   louder than the boundaries note it sits above: it is the last thing the page
+   says in its own voice before it states its limits. */
+.mf-closing-section{padding-block:clamp(1.1rem,3vw,1.9rem)}
+.mf-closing{max-width:62ch;margin:0;font-size:clamp(1rem,1.6vw,1.12rem);line-height:1.55;color:var(--mf-ink,inherit)}
+
+/* THE SEARCH ENTRY POINT, IN THE HERO
+   These pages all loaded the search engine and none of them showed a box.
+   The control sits under the hero actions so it is reachable without scrolling
+   on a 390px phone, and it never covers the hero — it is in normal flow, not
+   fixed or sticky, so nothing can occlude it and it cannot occlude anything. */
+.mf-hero-search,.mf-pupil-search{margin-top:clamp(.9rem,2.4vw,1.25rem);max-width:44rem}
+.mf-pupil-search-label,.mf-hero-search .mbm-search-label{display:block;font-weight:700;
+  font-size:.95rem;margin-bottom:.4rem}
+.mf-pupil-search-field{display:flex}
+.mf-pupil-search input{flex:1;min-height:48px;padding:.7rem .9rem;font:inherit;
+  border:2px solid var(--face-accent,#2f6b4d);border-radius:12px;background:#fff;color:inherit}
+.mf-pupil-search input:focus-visible{outline:3px solid var(--face-accent,#2f6b4d);outline-offset:2px}
+.mf-hero-search .mbm-search-field input{min-height:48px}
+.mf-hero-search .mbm-search-submit{min-height:48px;min-width:48px}
+.mf-pupil-search-status{margin:.55rem 0 0;font-size:.95rem;line-height:1.45}
+.mf-pupil-game[hidden],details.mf-pupil-genre[hidden]{display:none}
+@media (prefers-reduced-motion: reduce){
+  .mf-hero-search,.mf-pupil-search{transition:none}
+}
diff --git a/assets/mbm-recent.js b/assets/mbm-recent.js
index fd6df9a..dcfa69e 100644
--- a/assets/mbm-recent.js
+++ b/assets/mbm-recent.js
@@ -73,6 +73,21 @@
   function renderAll(){
     var roots=Array.prototype.slice.call(doc.querySelectorAll('[data-mbm-recent]'));
     if(!roots.length)return;
+    /* Nothing stored means nothing to resolve, so there is nothing to fetch.
+       This used to load the whole 754 KB search index on every page carrying a
+       recent-items block, on every device, including the ones that have never
+       opened a discovery card and would render the empty state either way. The
+       index is only needed to turn a STORED id into a title and a route. */
+    if(!read().length){
+      roots.forEach(function(root){
+        var list=root.querySelector('[data-mbm-recent-items]')||root;
+        var empty=root.querySelector('[data-mbm-recent-empty]');
+        list.textContent='';
+        if(empty)empty.hidden=false;
+        root.hidden=false;
+      });
+      return;
+    }
     loadIndex().then(function(index){roots.forEach(function(root){renderOne(root,index);});}).catch(function(){roots.forEach(function(root){root.hidden=true;});});
   }
 
